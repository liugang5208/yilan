server {
    listen 8088;
    server_name localhost 127.0.0.1 yilan.local;

    root /Users/liugang/data/workspace/yilan;
    index index.php index.html;

    access_log /usr/local/var/log/nginx/yilan.access.log;
    error_log /usr/local/var/log/nginx/yilan.error.log;

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_index index.php;

        # 二选一，按本机 PHP-FPM 实际监听地址修改
        fastcgi_pass 127.0.0.1:9000;
        # fastcgi_pass unix:/usr/local/var/run/php-fpm.sock;
    }

    location ~* \.(jpg|jpeg|gif|png|ico|svg|webp|css|js|map|woff|woff2|ttf|eot)$ {
        expires 7d;
        access_log off;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
