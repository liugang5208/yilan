SQL: UPDATE plate_conts_logs l
JOIN (
  SELECT l2.id,
    COALESCE(SUM(ROUND(f.end_price * p.ratio / 100, 4)), 0) AS new_price,
    COALESCE(SUM(ROUND(f.weight   * p.ratio / 100, 4)), 0) AS new_weight
  FROM plate_conts_logs l2
  JOIN plate_conts_price p ON p.blank_id = l2.blank_id AND p.is_del = 1
  JOIN new_cate_form f ON f.new_cate_id = p.new_cate_three_id AND f.number = l2.number
  WHERE l2.blank_id IN (
    SELECT blank_id FROM plate_conts_price WHERE new_cate_three_id = 931 AND is_del = 1
  )
  GROUP BY l2.id
) calc ON calc.id = l.id
SET
  l.price   = calc.new_price,
  l.market  = ROUND(calc.new_price * l.dratio, 2),
  l.weight  = calc.new_weight,
  l.uptimes = UNIX_TIMESTAMP() [ RunTime:0.0125s ]
