SQL: UPDATE plate_conts_logs l
                 SET
                   price  = (
                     SELECT COALESCE(SUM(ROUND(f.end_price * p.ratio / 100, 4)), 0)
                     FROM plate_conts_price p
                     JOIN new_cate_form f ON f.new_cate_id = p.new_cate_three_id AND f.number = l.number
                     WHERE p.blank_id = l.blank_id AND p.is_del = 1
